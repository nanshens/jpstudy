{
  "basics": [
    {
      "id": "keis体",
      "title": "敬体与简体",
      "summary": "学会在不同场合用合适的说法",
      "items": [
        { "term": "简体", "desc": "朋友/家人间用,亲密表达", "example": "書く" },
        { "term": "敬体", "desc": "正式场合用,陌生人/上司/服务场景", "example": "書きます" }
      ],
      "conjugation": "敬体 = 简体 + です/ます",
      "tip": "今日是敬体 → 今日です/書きます; 今日是简体 → 今日/書く"
    },
    {
      "id": "keigo",
      "title": "敬语体系总览",
      "summary": "尊敬语/谦让语/丁宁语的关系与代表动词",
      "items": [
        { "term": "尊敬语", "desc": "抬高对方的动作", "example": "いらっしゃる / なさる / おっしゃる" },
        { "term": "谦让语", "desc": "压低自己/我方人员的动作", "example": "申す / 参る / いただく" },
        { "term": "丁宁语", "desc": "礼貌语气", "example": "です / ます / ございます" }
      ],
      "conjugation": "尊敬语把对方动作抬高,谦让语把我方动作降低"
    },
    {
      "id": "classification",
      "title": "动词分类",
      "summary": "掌握动词的识别方法",
      "items": [
        { "term": "I 类(五段)", "desc": "词尾按五十音图う段变化,变形覆盖五段", "example": "書く / 話す / 行く / 泳ぐ" },
        { "term": "II 类(一段)", "desc": "去「る」+新后缀,只有一段", "example": "食べる / 寝る / 見る" },
        { "term": "III 类", "desc": "する(サ变)+ 来る(カ变)", "example": "する / 来る" }
      ],
      "conjugation": "古く(古)→ 来る(カ)变,する(サ)变特殊"
    },
    {
      "id": "jidoushi-tadoushi",
      "title": "自动词与他动词",
      "summary": "理解动作的主体与对象关系",
      "items": [
        { "term": "自动词", "desc": "动作自然发生(窗开了)", "example": "窓が開いた" },
        { "term": "他动词", "desc": "对对象施加动作(人开窗)", "example": "窓を開けた" }
      ],
      "conjugation": "開く(自)/ 開ける(他); 壊れる(自)/ 壊す(他)"
    },
    {
      "id": "conditional",
      "title": "条件表达对比",
      "summary": "ば/たら/なら/と的误用与场景选择",
      "items": [
        { "term": "ば", "desc": "一般/普遍真理", "example": "雨が降れば、行きません" },
        { "term": "たら", "desc": "具体/偶然/过去", "example": "雨が降ったら、行きません" },
        { "term": "なら", "desc": "以对方话题为前提", "example": "雨が降るなら、行きません" }
      ],
      "conjugation": "雨なら、傘で行こう → 雨が降るなら、出かけません"
    },
    {
      "id": "common-pitfalls",
      "title": "常见「坑」",
      "summary": "避开学日语中的易错点和陷阱",
      "items": [
        { "term": "分类混淆", "desc": "見ます/寝る分不清是 I 类还是 II 类?其实看词尾", "example": "「見」是ま行上一段,「寝」是ら行下一段" },
        { "term": "动词同形", "desc": "自动词即/他动词型,绝不混", "example": "「磨く」是 I 类," },
        { "term": "敬体误用", "desc": "对老师用简体是大忌", "example": "" }
      ]
    }
  ],

  "forms": [
    {
      "id": "masu",
      "name": "ます形 (礼貌形)",
      "emoji": "📝",
      "color": "from-pink-400 to-rose-500",
      "summary": "最常用也最安全的说法!工作/服务场景首选它~",
      "rules": [
        "I 类(五段):词尾う段→い段 +「ます」→ 書きます、書きます、飲みます、はなします",
        "II 类(一段):去「る」+「ます」→ 食べます、見ます",
        "III 类:来ます / します"
      ],
      "tips": ["如果不确定用法,先用ます形,既礼貌又稳妥!"],
      "examples": [
        { "word": "書く", "conjugation": "書きます", "translation": "写(现在/未来)" },
        { "word": "食べる", "conjugation": "食べました", "translation": "吃(过去)" },
        { "word": "お願いする", "conjugation": "お願いします", "translation": "拜托(固定礼貌表达)" }
      ]
    },
    {
      "id": "te",
      "name": "て形・た形",
      "emoji": "🎵",
      "color": "from-blue-400 to-cyan-500",
      "summary": "连接句子、表示请求/过去/并列,万能连接词!",
      "rules": [
        "I 类五段活用(三大类):",
        "  - う/つ/る → って: 書く→書いて、会う→会って",
        "  - く → いて: 書く→書いて(注意:特殊)、行く→行って",
        "  - ぐ → いで: 泳ぐ→泳いで",
        "  - む/ぶ/ぬ → んで: 飲む→飲んで、遊ぶ→遊んで、死ぬ→死んで",
        "  - す → して: 話す→話して",
        "II 类(一段):去「る」+「て/た」→ 食べて/食べた",
        "III 类:来て/来た、して/した"
      ],
      "tips": [
        "て形 + います:表示进行中(正在写=書いています)",
        "て形 + ください:表示请求(请写一下=書いてください)",
        "て形 + しまう:表示遗憾(写丢了=書いてしまった)"
      ],
      "examples": [
        { "word": "食べる", "conjugation": "食べて", "translation": "吃了(て形)" },
        { "word": "行く", "conjugation": "行って", "translation": "去了(注意:浊音化,不去「いて」)" },
        { "word": "飲む", "conjugation": "飲みました", "translation": "喝了(过去)" }
      ]
    },
